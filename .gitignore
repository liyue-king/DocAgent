# ============================================================
# DocAgent .gitignore
# ============================================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# 虚拟环境（uv / venv）
.venv/
venv/
env/
.workbuddy
.claude

# ----- 环境变量（密钥不入库，模板保留） -----
.env
.env.local

# ----- 支付宝沙箱密钥（不入库，仅保留 README/占位） -----
keys/*.pem
keys/

# ----- 运行时数据（不入库） -----
checkpoints/

# ----- 流程图设计文件（drawio 源文件/自动备份） -----
流程图/

# ----- AI 工作记忆（会话日志/项目笔记，不入库） -----
.workbuddy/

# ----- Docker 数据卷与运行产物 -----
# data/ 为四库容器挂载目录（仅保留占位文件）
data/*
!data/.gitkeep
# ChromaDB 本机持久化目录（容器方式下数据在 data/chroma）
chroma_data/

# ----- 日志 -----
logs/
*.log

# ----- Celery beat 调度器运行时文件 -----
celerybeat-schedule*

# ----- 前端 (Vue3 + Vite) -----
node_modules/
frontend/dist/
frontend/.vite/
*.local

# ----- IDE / 编辑器 -----
.idea/
.vscode/
*.swp
*.swo

# ----- 操作系统 -----
.DS_Store
Thumbs.db
