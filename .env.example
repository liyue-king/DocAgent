# ============================================================
# DocAgent 应用环境变量模板
# 使用方式：复制为 .env 后填入真实密钥
#   cp .env.example .env
# ============================================================

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3307   # 宿主机 3306 被本机 MySQL 占用，Docker 容器映射到 3307
MYSQL_USER=root
MYSQL_PASSWORD=docagent123
MYSQL_DATABASE=docagent

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/2
REDIS_SNAPSHOT_TTL_SECONDS=3600
REDIS_LOGS_MAX=20
REDIS_RATELIMIT_TTL_SECONDS=60
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=docagent
MINIO_SECRET_KEY=docagent123
MINIO_SECURE=false
MINIO_INPUT_BUCKET=docagent-input
MINIO_OUTPUT_BUCKET=docagent-output
MINIO_KNOWLEDGE_BUCKET=docagent-knowledge
MINIO_PRESIGN_EXPIRES_SECONDS=300
MINIO_CONNECT_TIMEOUT_SECONDS=5
MINIO_READ_TIMEOUT_SECONDS=5
MINIO_CONNECT_RETRIES=0

# ChromaDB
CHROMA_HOST=localhost
# 使用 8002 而非 8000：避免本机其他 FastAPI/uvicorn 占用 8000 时顶掉 Chroma
CHROMA_PORT=8002
CHROMA_HEALTH_TIMEOUT_SECONDS=2

# LLM (DeepSeek / OpenAI / 千问 Qwen)
LLM_PROVIDER=qwen  # deepseek | openai | qwen
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
QWEN_API_KEY=sk-ws-xxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-max  # 或 deepseek-chat / gpt-4o-mini

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_SOFT_TIME_LIMIT_SECONDS=240
CELERY_TIME_LIMIT_SECONDS=300
CELERY_BEAT_SWEEP_INTERVAL_SECONDS=3600
# 开发态：随 API 网关自动拉起 Celery（IDEA 直跑 uvicorn 免开终端）
# 日志见 logs/celery_worker.log、logs/celery_beat.log；Docker/生产保持 false
AUTO_START_WORKER=false
AUTO_START_BEAT=false

# 登录认证 (JWT)
JWT_SECRET=dev-secret-change-me   # 生产环境务必更换为随机长字符串
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72
# 管理员邮箱（逗号分隔）：注册/登录/初始化时自动授予管理员权限
ADMIN_EMAILS=your_email@qq.com

# SMTP 邮箱验证码 (QQ 邮箱需在设置中开启 SMTP 获取授权码)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_auth_code
SMTP_FROM=your_email@qq.com
EMAIL_CODE_TTL_SECONDS=300
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# 支付宝沙箱
ALIPAY_APP_ID=9021000165600064
ALIPAY_PRIVATE_KEY_PATH=keys/app_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=keys/alipay_public_key.pem
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=http://localhost:8001/api/v1/pay/notify
ALIPAY_RETURN_URL=http://localhost:5173/pricing
ALIPAY_USER_ID=2088722102597409
ALIPAY_QUERY_TIMEOUT_SECONDS=5

# MinerU 文档解析（可选：知识库上传优先用 MinerU 提取文本与图片，失败自动降级本地提取）
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_TIMEOUT_SECONDS=120

# LangGraph Checkpointer（SQLite 断点文件，容器内默认 /app/checkpoints）
CHECKPOINT_DB_PATH=checkpoints/checkpoint.db

# 应用
MAX_FILE_SIZE_MB=20
TASK_EXPIRE_HOURS=24
MAX_RETRY_COUNT=3
API_RATE_LIMIT=10  # 每分钟请求数
CORS_ALLOW_ORIGINS=*
API_CLIENT_TIMEOUT_SECONDS=30
API_BASE_URL=http://localhost:8001
API_PORT=8001
